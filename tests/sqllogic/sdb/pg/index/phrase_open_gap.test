# ----------------------------------------------------------------------
# Three words, one exact and one open junction. Documents 10..15:
#  10 alpha beta gamma        12 alpha beta y gamma   14 beta alpha gamma
#  11 alpha x beta y y gamma  13 alpha x beta gamma   15 alpha beta
# alpha, exactly one word, beta, anything, gamma: 11 and 13 only.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('alpha', 1, 'beta', [0, NULL], 'gamma') ORDER BY a;
----
a
11
13

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('alpha', 1, 'beta', [0, NULL], 'gamma') ORDER BY a;
----
a
11
13

query
SELECT a FROM og_pos WHERE b @@ ('alpha' ## 1 ## 'beta' ## [0, NULL] ## 'gamma') ORDER BY a;
----
a
11
13

query
SELECT a FROM og_txt WHERE b @@ ('alpha' ## 1 ## 'beta' ## [0, NULL] ## 'gamma') ORDER BY a;
----
a
11
13

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('"alpha 2-2 beta 1-* gamma"') ORDER BY a;
----
a
11
13

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('"alpha 2-2 beta 1-* gamma"') ORDER BY a;
----
a
11
13

# ----------------------------------------------------------------------
# An open junction first, an exact one second: 'beta' anywhere after 'alpha', then exactly one word, then 'gamma'.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('alpha', [0, NULL], 'beta', 1, 'gamma') ORDER BY a;
----
a
12

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('alpha', [0, NULL], 'beta', 1, 'gamma') ORDER BY a;
----
a
12

# ----------------------------------------------------------------------
# fn:ordered of three words: 10..13.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('fn:ordered(alpha beta gamma)') ORDER BY a;
----
a
10
11
12
13

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('fn:ordered(alpha beta gamma)') ORDER BY a;
----
a
10
11
12
13

# ----------------------------------------------------------------------
# A repeated word needs two occurrences: 16 'echo', 17 'echo echo', 18 'echo x echo'.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('fn:ordered(echo echo)') ORDER BY a;
----
a
17
18

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('fn:ordered(echo echo)') ORDER BY a;
----
a
17
18

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('echo', [0, NULL], 'echo') ORDER BY a;
----
a
17
18

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('echo', [0, NULL], 'echo') ORDER BY a;
----
a
17
18

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('echo', [1, NULL], 'echo') ORDER BY a;
----
a
18

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('echo', [1, NULL], 'echo') ORDER BY a;
----
