18

# ----------------------------------------------------------------------
# Scoring: the same-size documents 20, 21, 22 hold 'sun' and 'moon' at distance
# 1, 6 and 3 apart (spans of width 2, 8 and 4). Each minimal span weighs
# 1 / (width - 2 + 1) = 1, 1/7 and 1/3, so the order is 20, 22, 21.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('sun', [0, NULL], 'moon') ORDER BY BM25(og_pos.tableoid) DESC, a;
----
a
20
22
21

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('sun', [0, NULL], 'moon') ORDER BY BM25(og_txt.tableoid) DESC, a;
----
a
20
22
21

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('fn:ordered(sun moon)') ORDER BY BM25(og_pos.tableoid) DESC, a;
----
a
20
22
21

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('fn:ordered(sun moon)') ORDER BY BM25(og_txt.tableoid) DESC, a;
----
a
20
22
21

# ----------------------------------------------------------------------
# Slop cannot be combined with an open gap.
# ----------------------------------------------------------------------

query error
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [0, NULL], 'fox', slop := 1);
----
db error: ERROR: slop is incompatible with interval gaps ([min, max])
HINT: Use exact gaps (single INTEGER) with slop, or drop it.


query error
SELECT a FROM og_txt WHERE b @@ ts_phrase('brown', [0, NULL], 'fox', slop := 1);
----
db error: ERROR: slop is incompatible with interval gaps ([min, max])
HINT: Use exact gaps (single INTEGER) with slop, or drop it.


query error
SELECT a FROM og_pos WHERE b @@ to_tsquery('"brown 1-* fox"~2');
----
db error: ERROR: slop is incompatible with interval gaps (min-max)
HINT: Use exact gaps ("quick 2-2 fox") with ~N, or drop the slop.


query error
SELECT a FROM og_txt WHERE b @@ to_tsquery('"brown 1-* fox"~2');
----
db error: ERROR: slop is incompatible with interval gaps (min-max)
HINT: Use exact gaps ("quick 2-2 fox") with ~N, or drop the slop.


# ----------------------------------------------------------------------
# An open lower bound is not allowed.
# ----------------------------------------------------------------------

query error
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [NULL, 3], 'fox');
----
db error: ERROR: ts_phrase gap must be a non-null non-negative integer, got NULL of type INTEGER (argument 1)
HINT: Example: ts_phrase('quick brown fox') or ts_phrase('a', 1, 'b', slop := 2). INTEGER / INTEGER[] gap allowed between text args; `slop := N` is a non-negative budget for position rearrangements (incompatible with interval gaps).


# ----------------------------------------------------------------------
# EXPLAIN prints an open gap as (min, *).
# ----------------------------------------------------------------------

query
EXPLAIN SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [2, NULL], 'fox');
----
QUERY PLAN
╭─ IRESEARCH_SCAN ───────────────────────╮
│ Index: og_pos                          │
│ Lookup: table                          │
│ Index Filter:                          │
│ ╭─ Phrase ───────────────────────────╮ │
│ │ Field: b(string)                   │ │
│ │ Parts:                             │ │
│ │ Term:brown(0, 0); Term:fox(3, *);  │ │
│ ╰────────────────────────────────────╯ │
│ Projections: a                         │
│ ~4 rows                                │
╰────────────────────────────────────────╯

# ----------------------------------------------------------------------
# The values of an array column are contiguous, so an open gap matches across elements.
# ----------------------------------------------------------------------

statement ok
CREATE TABLE og_lists (a INTEGER PRIMARY KEY, tags VARCHAR[]);

statement ok
INSERT INTO og_lists VALUES
    (1, ['brown pad', 'pad fox']),
    (2, ['fox pad', 'pad brown']),
    (3, ['brown', 'fox']),
    (4, ['brown pad', 'pad']);

statement ok
CREATE INDEX og_lists_pos ON og_lists USING inverted (a, tags og_words_pos);

statement ok
CREATE INDEX og_lists_txt ON og_lists USING inverted (a, tags og_words) INCLUDE (tags);

statement ok
VACUUM (REFRESH_TABLE) og_lists;

query
SELECT a FROM og_lists_pos WHERE tags @@ ts_phrase('brown', [0, NULL], 'fox') ORDER BY a;
----
a
1
3

query
SELECT a FROM og_lists_txt WHERE tags @@ ts_phrase('brown', [0, NULL], 'fox') ORDER BY a;
----
a
1
3
