hash-threshold 100

statement ok
CREATE TEXT SEARCH DICTIONARY og_words_pos AS split_text(case := 'lower') WITH (frequency, position);

statement ok
CREATE TEXT SEARCH DICTIONARY og_words AS split_text(case := 'lower') WITH (frequency);

statement ok
CREATE TABLE og (a INTEGER PRIMARY KEY, b VARCHAR);

statement ok
INSERT INTO og VALUES
    (1, 'brown fox'),
    (2, 'brown quick fox'),
    (3, 'brown quick red fox'),
    (4, 'fox brown'),
    (5, 'brown cat dog eel fox'),
    (6, 'brown'),
    (7, 'fox quick brown red fox'),
    (10, 'alpha beta gamma'),
    (11, 'alpha x beta y y gamma'),
    (12, 'alpha beta y gamma'),
    (13, 'alpha x beta gamma'),
    (14, 'beta alpha gamma'),
    (15, 'alpha beta'),
    (16, 'echo'),
    (17, 'echo echo'),
    (18, 'echo x echo'),
    (20, 'sun moon pad pad pad pad pad pad'),
    (21, 'sun pad pad pad pad pad pad moon'),
    (22, 'sun pad pad moon pad pad pad pad');

# ----------------------------------------------------------------------
# Documents 8 and 9 are 20002 words long, with the two words at opposite ends.
# ----------------------------------------------------------------------

statement ok
INSERT INTO og SELECT 8, 'brown ' || repeat('x ', 20000) || 'fox';

statement ok
INSERT INTO og SELECT 9, 'fox ' || string_agg('x', ' ') || ' brown' FROM range(20000);

statement ok
CREATE INDEX og_pos ON og USING inverted (a, b og_words_pos);

statement ok
CREATE INDEX og_txt ON og USING inverted (a, b og_words) INCLUDE (b);

statement ok
VACUUM (REFRESH_TABLE) og;

# ----------------------------------------------------------------------
# The long documents really are long.
# ----------------------------------------------------------------------

query
SELECT a, array_length(string_split(b, ' ')) AS words FROM og WHERE a IN (8, 9) ORDER BY a;
----
a	words
8	20002
9	20002

# ----------------------------------------------------------------------
# [m, NULL]: the next word at least m inserted words after the previous one,
# at any distance. Document by document, with 'brown' ... 'fox':
#  1 adjacent (0 inserted)   2 one inserted   3 two inserted   4 reversed
#  5 three inserted   6 no fox   7 'fox quick brown red fox': one inserted
#  8 20000 inserted   9 reversed
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# [0, NULL]: anywhere after, adjacent included.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [0, NULL], 'fox') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('brown', [0, NULL], 'fox') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_pos WHERE b @@ ('brown' ## [0, NULL] ## 'fox') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ ('brown' ## [0, NULL] ## 'fox') ORDER BY a;
----
a
1
2
3
5
7
8

# ----------------------------------------------------------------------
# [1, NULL]: at least one inserted word.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [1, NULL], 'fox') ORDER BY a;
----
a
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('brown', [1, NULL], 'fox') ORDER BY a;
----
a
2
3
5
7
8

# ----------------------------------------------------------------------
# [2, NULL]: document 3 has exactly two inserted words and matches,
# documents 2 and 7 have exactly one and do not.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [2, NULL], 'fox') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('brown', [2, NULL], 'fox') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_pos WHERE b @@ ('brown' ## [2, NULL] ## 'fox') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_txt WHERE b @@ ('brown' ## [2, NULL] ## 'fox') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('brown', [3, NULL], 'fox') ORDER BY a;
----
a
5
8

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('brown', [3, NULL], 'fox') ORDER BY a;
----
a
5
8

# ----------------------------------------------------------------------
# The other order: 'fox' before 'brown' (4, 7 and 9 only).
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ ts_phrase('fox', [0, NULL], 'brown') ORDER BY a;
----
a
4
7
9

query
SELECT a FROM og_txt WHERE b @@ ts_phrase('fox', [0, NULL], 'brown') ORDER BY a;
----
a
4
7
9

# ----------------------------------------------------------------------
# Lucene query string: "a N-* b" is distance at least N (1 = adjacent).
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('"brown 1-* fox"') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('"brown 1-* fox"') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('"brown 2-* fox"') ORDER BY a;
----
a
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('"brown 2-* fox"') ORDER BY a;
----
a
2
3
5
7
8

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('"brown 3-* fox"') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('"brown 3-* fox"') ORDER BY a;
----
a
3
5
8

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('"fox 1-* brown"') ORDER BY a;
----
a
4
7
9

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('"fox 1-* brown"') ORDER BY a;
----
a
4
7
9

# ----------------------------------------------------------------------
# fn:ordered: the words in this order at any distance.
# ----------------------------------------------------------------------

query
SELECT a FROM og_pos WHERE b @@ to_tsquery('fn:ordered(brown fox)') ORDER BY a;
----
a
1
2
3
5
7
8

query
SELECT a FROM og_txt WHERE b @@ to_tsquery('fn:ordered(brown fox)') ORDER BY a;
